# GitHub OAuth App used by the blog editor at /admin.
# Create the app at https://github.com/settings/developers
# Authorization callback URL: https://www.jakelipohar.ca/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Must match backend.base_url in admin/config.yml and the callback host.
# SITE_URL=https://www.jakelipohar.ca
